<meta property="og:image" content="/assets/images/opengraph-image.png"/>

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="Check my diary">

{% if googleAnalyticsId %}
  <!-- Google Tag Manager -->
  <script nonce="{{ cspNonce }}" async src="https://www.googletagmanager.com/gtag/js?id={{ googleAnalyticsId }}"></script>
  <script nonce="{{ cspNonce }}">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', '{{ googleAnalyticsId }}');
  </script>
{% endif %}
